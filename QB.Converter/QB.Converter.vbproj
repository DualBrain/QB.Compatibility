<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>qb2vb</AssemblyName>
    <RootNamespace>
    </RootNamespace>
    <StartupObject>QB2VB.Program</StartupObject>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
    <OptionStrict>On</OptionStrict>
    <LangVersion>latest</LangVersion>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>qb2vb</ToolCommandName>
    <PackageId>qb2vb</PackageId>
    <Description>qb2vb: converts QBasic and QuickBASIC source to Visual Basic (.NET) programs that use QB.Compatibility.</Description>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="QB.Converter.Tests" />
  </ItemGroup>
</Project>
