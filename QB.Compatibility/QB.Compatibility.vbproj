<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>
    </RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>QB.Compatibility</AssemblyName>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
    <OptionStrict>On</OptionStrict>
    <LangVersion>latest</LangVersion>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
    <IsPackable>true</IsPackable>
    <PackageId>QB.Compatibility</PackageId>
    <Description>A QuickBASIC 4.5 and QBasic compatibility library for Visual Basic (.NET): the statements and functions of the language (text, files, errors, events, sound) for programs migrated from QB.</Description>
  </PropertyGroup>
  <ItemGroup>
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="QB.Compatibility.Sdl" />
    <InternalsVisibleTo Include="QB.Compatibility.Tests" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="My Project\" />
  </ItemGroup>
</Project>
