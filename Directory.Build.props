<Project>

  <!-- Nothing is packed unless a project opts in with <IsPackable>true</IsPackable>. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- One version for everything that ships; the packages rely on one another. -->
  <PropertyGroup>
    <Version>0.1.1</Version>
    <Authors>Cory Smith</Authors>
    <Copyright>Copyright (c) Cory Smith</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/DualBrain/QB.Compatibility</PackageProjectUrl>
    <RepositoryUrl>https://github.com/DualBrain/QB.Compatibility</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>qbasic;quickbasic;basic;vb;visualbasic;compatibility;retro</PackageTags>
  </PropertyGroup>

  <!-- Debug information travels inside the assembly, with SourceLink (built into the .NET SDK), so a separate symbol package isn't needed. -->
  <PropertyGroup>
    <DebugType>embedded</DebugType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
