Module Program

  Public Sub Main()
    QB.Video.WaitForKeyAtExit = True
#If QB_WINDOW Then
    QB.SdlBackend.Use()
#End If
    ' From the QBasic manual: https://qbasic.net/en/qb-manual/Function/INKEY%24.htm
    PRINT("Press Esc to exit...")
    Do
    Loop Until INKEY$() = QBChr(27)  '27 is the ASCII code for Esc.
  End Sub

End Module
