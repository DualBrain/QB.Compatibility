<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>QB2VB.Tests</RootNamespace>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
    <OptionStrict>On</OptionStrict>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Golden\**" />
    <None Include="Golden\**" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\QB.Converter\QB.Converter.vbproj" />
    <ProjectReference Include="..\QB.Compatibility\QB.Compatibility.vbproj" />
    <ProjectReference Include="..\QB.Compatibility.Sdl\QB.Compatibility.Sdl.vbproj" />
    <ProjectReference Include="..\QB.Compatibility.Ports\QB.Compatibility.Ports.vbproj" />
  </ItemGroup>
</Project>
