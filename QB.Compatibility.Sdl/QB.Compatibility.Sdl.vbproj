<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>
    </RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>QB.Compatibility.Sdl</AssemblyName>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
    <OptionStrict>On</OptionStrict>
    <LangVersion>latest</LangVersion>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
    <IsPackable>true</IsPackable>
    <PackageId>QB.Compatibility.Sdl</PackageId>
    <Description>The SDL2 window for QB.Compatibility: QBasic graphics (SCREEN, PSET, LINE, CIRCLE, PAINT, GET/PUT, DRAW, PALETTE), the joystick and the pen. Only needed by programs that draw.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ppy.SDL2-CS" Version="1.0.82" />
    <ProjectReference Include="..\QB.Compatibility\QB.Compatibility.vbproj" />
  </ItemGroup>
</Project>
