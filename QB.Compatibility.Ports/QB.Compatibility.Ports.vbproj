<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>
    </RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>QB.Compatibility.Ports</AssemblyName>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
    <OptionStrict>On</OptionStrict>
    <LangVersion>latest</LangVersion>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
    <IsPackable>true</IsPackable>
    <PackageId>QB.Compatibility.Ports</PackageId>
    <Description>Serial port support for QB.Compatibility: OPEN "COM1:..." and ON COM. Only needed by programs that use a serial port.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="10.0.1" />
    <ProjectReference Include="..\QB.Compatibility\QB.Compatibility.vbproj" />
  </ItemGroup>
</Project>
